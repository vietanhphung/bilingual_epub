# LLM provider
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Scheduler
SCHEDULE_MODE=MANUAL
SCHEDULE_TIME=02:00
SCHEDULE_TIMEZONE=America/Toronto
SCHEDULE_DAY_OF_WEEK=SUN

# Per-request limits
MAX_SOURCE_TOKENS_PER_REQUEST=8000
MAX_ESTIMATED_OUTPUT_TOKENS_PER_REQUEST=12000

# Per-run limits
MAX_REQUESTS_PER_RUN=10
MAX_INPUT_TOKENS_PER_RUN=100000
MAX_OUTPUT_TOKENS_PER_RUN=140000

# Per-day limits
MAX_INPUT_TOKENS_PER_DAY=100000
MAX_OUTPUT_TOKENS_PER_DAY=140000

# Per-month limits
MAX_INPUT_TOKENS_PER_MONTH=2000000
MAX_OUTPUT_TOKENS_PER_MONTH=2800000

TOKEN_SAFETY_MARGIN_PERCENT=20
MAX_RETRIES_PER_SEGMENT=3
REQUEST_DELAY_MS=1500

# Optional monetary budgets (USD)
MAX_COST_PER_RUN_USD=
MAX_COST_PER_DAY_USD=
MAX_COST_PER_MONTH_USD=

# Optional: current provider pricing for LLM_MODEL, used only to compute
# cost estimates and enforce the monetary budgets above. Not pre-filled —
# check your provider's current pricing page and set these yourself.
MODEL_INPUT_PRICE_PER_MILLION_TOKENS_USD=
MODEL_OUTPUT_PRICE_PER_MILLION_TOKENS_USD=

# Local paths
DATABASE_PATH=./data/bilingual-epub.sqlite
LOG_LEVEL=info

# Test flag
RUN_LIVE_LLM_TESTS=false
